                                                <TextBlock Text="Lazer Çubuk Genişliği" Foreground="{StaticResource TextDimBrush}" FontSize="12" Margin="0,8,0,2"/>
                                                <Slider Minimum="0.8" Maximum="3.5" Value="{Binding Scan.BeamWidth}"/>
                                                <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Scan.RainbowMode}" Margin="0,8,0,8">
                                                    <TextBlock Text="Gökkuşağı Spektrum Modu" FontSize="12" Foreground="{StaticResource TextDimBrush}"/>
                                                </CheckBox>
                                            </StackPanel>

                                            <!-- 14. Pulse Controls -->
                                            <StackPanel x:Name="PulseControlsPanel" Visibility="Collapsed">
                                                <TextBlock Text="Nabız Hızı" Foreground="{StaticResource TextDimBrush}" FontSize="12" Margin="0,4,0,2"/>
                                                <Slider Minimum="0.3" Maximum="3.0" Value="{Binding Pulse.Speed}"/>
                                                <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Pulse.HeartbeatMode}" Margin="0,8,0,6">
                                                    <TextBlock Text="Gerçekçi Çift Vuruş Kalp Atışı (Lub-Dub Ritmi)" FontSize="12" Foreground="{StaticResource TextDimBrush}"/>
                                                </CheckBox>
                                                <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Pulse.RainbowCycle}" Margin="0,0,0,8">
                                                    <TextBlock Text="Spektrum Renk Döngüsü" FontSize="12" Foreground="{StaticResource TextDimBrush}"/>
                                                </CheckBox>
                                            </StackPanel>

                                            <!-- 15. Strobe Controls -->
                                            <StackPanel x:Name="StrobeControlsPanel" Visibility="Collapsed">
                                                <TextBlock Text="Flaş Frekansı (Hz)" Foreground="{StaticResource TextDimBrush}" FontSize="12" Margin="0,4,0,2"/>
                                                <Slider Minimum="1.0" Maximum="14.0" Value="{Binding Strobe.FrequencyHz}"/>
                                                <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Strobe.AlternateColor}" Margin="0,8,0,8">
                                                    <TextBlock Text="Mor &amp; Beyaz Çift Renk Değişimli Flaş" FontSize="12" Foreground="{StaticResource TextDimBrush}"/>
                                                </CheckBox>
                                            </StackPanel>

                                            <!-- 16. Generic & Interactive Parameter Panel -->
                                            <StackPanel x:Name="GenericControlsPanel" Visibility="Visible">
                                                <Border Background="{StaticResource CardSubBgBrush}" CornerRadius="9" Padding="12,10" Margin="0,2,0,4" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                                    <StackPanel>
                                                        <Grid Margin="0,0,0,4">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding SelectedEffectItem.IconGlyph}" FontSize="14.5" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding SelectedEffectItem.DisplayName}" FontWeight="Bold" FontSize="13" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <Button Content="🔄 Oyunu / Efekti Yeniden Başlat" Click="ResetEffect_Click" Style="{StaticResource PrimaryAccentButton}" Padding="10,4" FontSize="10.5" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                        <TextBlock x:Name="GenericControlHintText" Text="⚡ Klavye tuş vuruşları ve fare hareketleri ile gerçek zamanlı etkileşime girebilirsiniz."
                                                                   Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11" Margin="0,2,0,6" TextWrapping="Wrap"/>

                                                        <!-- Dynamic Speed Multiplier Panel (Inline Quick Presets + Smooth Slider) -->
                                                        <StackPanel x:Name="GenericSpeedPanel" Margin="0,2,0,0">
                                                            <Grid Margin="0,0,0,3">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="Efekt Akış Hızı / Tempo Çarpanı" Foreground="{StaticResource TextDimBrush}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Button Content="0.5x Yavaş" Click="GenericSpeedPreset_Click" Tag="0.5" Style="{StaticResource CyberButton}" Padding="7,2" FontSize="9.5" Margin="0,0,4,0"/>
                                                                    <Button Content="1.0x Normal" Click="GenericSpeedPreset_Click" Tag="1.0" Style="{StaticResource CyberButton}" Padding="7,2" FontSize="9.5" Margin="0,0,4,0"/>
                                                                    <Button Content="1.5x Hızlı" Click="GenericSpeedPreset_Click" Tag="1.5" Style="{StaticResource CyberButton}" Padding="7,2" FontSize="9.5" Margin="0,0,4,0"/>
                                                                    <Button Content="2.5x Turbo" Click="GenericSpeedPreset_Click" Tag="2.5" Style="{StaticResource CyberButton}" Padding="7,2" FontSize="9.5" Margin="0,0,10,0"/>
                                                                    <TextBlock Text="{Binding GenericSpeedMultiplier, StringFormat='{}{0:F1}x'}" Foreground="#C084FC" FontWeight="Bold" FontSize="12" Width="32" TextAlignment="Right" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Grid>
                                                            <Slider Minimum="0.2" Maximum="3.0" Value="{Binding GenericSpeedMultiplier}" SmallChange="0.1" LargeChange="0.5" Height="20" IsMoveToPointEnabled="True"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </TabItem>

                            <!-- TAB 1: ÖZEL PER-KEY BOYAMA EDİTÖRÜ -->
                            <TabItem Header="🎨 Per-Key Boyama Editörü">
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="380"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Sol: Bölge Boyama Tuşları & Bilgi -->
                                    <Border Grid.Column="0" Background="{StaticResource CardBgBrush}" CornerRadius="12"
                                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Padding="16,14" Margin="0,0,10,0">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel Orientation="Vertical" Margin="0,0,0,12">
                                                <TextBlock Text="İnteraktif Vektörel Klavye Boyama" FontSize="15.5" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,4"/>
                                                <TextBlock Text="Yukarıdaki canlı sanal klavyeden istediğiniz tuşa tıklayarak sağdaki paletten seçtiğiniz rengi anında atayabilirsiniz."
                                                           Foreground="{StaticResource TextDimBrush}" FontSize="11.5" Margin="0,0,0,12" TextWrapping="Wrap"/>

                                                <!-- Drag-to-paint Brush Mode Announcement -->
                                                <Border Background="#1A132C" BorderBrush="#7C3AED" BorderThickness="1.5" CornerRadius="8" Padding="12,9" Margin="0,0,0,12">
                                                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#EDE9FE">
                                                        <Run Text="🖌 Sürükle-Boya Fırça Modu Aktif: " FontWeight="Bold" Foreground="#C084FC"/>
                                                        <Run Text="Farenin sol tuşunu basılı tutup klavye üzerinde gezdirerek tüm tuşları tek hamlede boyayabilirsiniz!"/>
                                                    </TextBlock>
                                                </Border>

                                                <TextBlock Text="Hızlı Bölge Boyama Tuşları:" Foreground="{StaticResource TextDimBrush}" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,8"/>
                                                <WrapPanel Margin="0,0,0,12">
                                                    <Button Content="Tümünü Boya" Click="PaintAll_Click" Style="{StaticResource CyberButton}" Margin="0,0,8,8"/>
                                                    <Button Content="WASD Tuşları" Click="PaintWasd_Click" Style="{StaticResource PrimaryAccentButton}" Margin="0,0,8,8"/>
                                                    <Button Content="Yön Tuşları (Oklar)" Click="PaintArrows_Click" Style="{StaticResource CyberButton}" Margin="0,0,8,8"/>
                                                    <Button Content="Numpad Grubu" Click="PaintNumpad_Click" Style="{StaticResource CyberButton}" Margin="0,0,8,8"/>
                                                    <Button Content="Fonksiyon (F) Tuşları" Click="PaintFn_Click" Style="{StaticResource CyberButton}" Margin="0,0,8,8"/>
                                                    <Button Content="Sayı Tuşları (1-0)" Click="PaintNumbers_Click" Style="{StaticResource CyberButton}" Margin="0,0,8,8"/>
                                                    <Button Content="Harf Tuşları (Q-Z)" Click="PaintAlpha_Click" Style="{StaticResource CyberButton}" Margin="0,0,8,8"/>
                                                    <Button Content="Işıkları Kapat (Siyah)" Click="PaintBlack_Click" Style="{StaticResource CyberButton}" Margin="0,0,8,8"/>
                                                </WrapPanel>

                                                <Border Background="{StaticResource CardSubBgBrush}" CornerRadius="8" Padding="12,10" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock Text="Türkçe ISO Q Düzeni Tam Desteği" FontWeight="Bold" FontSize="12.5" Foreground="#F8FAFC" Margin="0,0,0,4"/>
                                                        <TextBlock Text="mrSpyCC; Türkçe ISO klavyelerdeki özel tuşları (Büyüktür/Küçüktür &lt; &gt;, Çift Katlı Enter, Ğ, Ü, Ş, İ, Ö, Ç) donanım adres ofsetlerine birebir eşler."
                                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>

                                    <!-- Sağ: Renk Paleti & Kaydırıcılar -->
                                    <Border Grid.Column="1" Background="{StaticResource CardBgBrush}" CornerRadius="12"
                                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Padding="12,10">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <controls:ColorPicker x:Name="PerKeyColorPicker" VerticalAlignment="Top"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <!-- TAB 2: SİSTEM & DONANIM KİLİDİ (GCUBridge) -->
                            <TabItem Header="🔒 Sistem &amp; Kilit Yönetimi">
                                <Border Background="{StaticResource CardBgBrush}" CornerRadius="12"
                                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Padding="18,14" Margin="0,4,0,0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Orientation="Vertical" MaxWidth="880" HorizontalAlignment="Left" Margin="0,0,0,16">
                                            <TextBlock Text="ITE8291 Donanım Kilidi &amp; Üretici Çakışma Arbitrasyonu" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,6"/>
                                            <TextBlock Text="Game Garaj Kontrol Merkezi (GCUBridge servisi), klavyenin RGB kontrolcüsünü arka planda açık tutarak belirli aralıklarla kendi aydınlatma profilini zorlar. mrSpyCC, GCUBridge'i anlık askıya alıp Windows USB HID arayüzünü özel modda (dwShareMode = 0) kilitler ve servisi hemen yeniden başlatır. Böylece fan eğrileri, soğutma profilleri ve donanım telemetrisi %100 çalışmaya devam ederken RGB çakışması tamamen engellenir."
                                                       Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" FontSize="12" LineHeight="19" Margin="0,0,0,18"/>

                                            <!-- Canlı Kilit Durumu Kartı -->
                                            <Border x:Name="SystemLockStatusCard" Background="{StaticResource CardSubBgBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,16" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <TextBlock x:Name="SystemLockStatusTitle" Text="✓ Özel Donanım Kilidi AKTİF" FontWeight="Bold" FontSize="14.5" Foreground="#4ADE80"/>
                                                            <Border Background="#163824" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="dwShareMode = 0" FontSize="10" FontWeight="SemiBold" Foreground="#86EFAC"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock x:Name="SystemLockStatusDesc" Text="Cihaz mrSpyCC tarafından güvenle kilitlenmiştir. Game Garaj yazılımı fanları yönetmeye devam ederken RGB çakışması engellenmiştir. Hiçbir işlem yapmanıza gerek yoktur."
                                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" x:Name="SystemRelockBtn" Content="Kilidi Yenile / Al" Click="RelockButton_Click" Style="{StaticResource PrimaryAccentButton}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                                </Grid>
                                            </Border>

                                            <!-- Windows Açılışında Görev Zamanlayıcı Kartı -->
                                            <Border Background="{StaticResource CardSubBgBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,16" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="Windows Açılışında Otomatik Başlat (Sessiz Kilit)" FontWeight="Bold" FontSize="14" Foreground="#F8FAFC"/>
                                                        <TextBlock Text="Windows Task Scheduler üzerinden UAC bildirimi olmaksızın en yüksek yetkiyle oturum açıldığında arka planda başlar."
                                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding AutoStartEnabled}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <!-- Teknik Donanım Parametreleri -->
                                            <Border Background="{StaticResource CardSubBgBrush}" CornerRadius="10" Padding="16" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock Text="Donanım İletişim Parametreleri" FontWeight="Bold" FontSize="13" Foreground="#F8FAFC" Margin="0,0,0,8"/>
                                                    <TextBlock Text="• Cihaz: ITE Tech. Device (VID: 048D, PID: 600B, Interface: 01)&#x0a;• İletişim Modu: Raw USB HID (SetFeature &amp; WriteFile 8x64 Bayt Çerçeveler)&#x0a;• Frame Pacer: Capped ~31.25 FPS (32.0 ms Donanım Koruma Gecikmesi)&#x0a;• Çekirdek Kancası: WH_KEYBOARD_LL (Genişletilmiş Tuş / Numpad Enter Ayrımı)"
                                                               FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextDimBrush}" LineHeight="18"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </TabItem>

                            <!-- TAB 3: PROFİLLER & ÖNAYARLAR -->
                            <TabItem Header="📁 Profiller &amp; Önayarlar">
                                <Border Background="{StaticResource CardBgBrush}" CornerRadius="12"
                                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Padding="16,14" Margin="0,6,0,0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                                        <StackPanel Orientation="Vertical" Margin="0,0,0,16">
                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="Kayıtlı Aydınlatma &amp; Donanım Profilleri" FontSize="15.5" FontWeight="Bold" Foreground="#F8FAFC"/>
                                                    <TextBlock Text="Mevcut ayarlarınızı yeni bir profil olarak kaydedebilir, silebilir veya JSON olarak dışa/içe aktarabilirsiniz." FontSize="11.5" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Button x:Name="ImportProfileBtn" Content="📥 Profil İçe Aktar (.json)" Click="ImportProfileBtn_Click"
                                                            Style="{StaticResource CyberButton}" Margin="0,2,8,2" Padding="12,7" FontSize="11"/>
                                                    <Button x:Name="CreateProfileBtn" Content="➕ Yeni Profil Kaydet" Click="CreateProfileBtn_Click"
                                                            Style="{StaticResource PrimaryAccentButton}" Margin="0,2,0,2" Padding="14,7" FontSize="11"/>
                                                </WrapPanel>
                                            </Grid>

                                            <!-- Yeni Profil Oluşturma Paneli (Açılır/Kapanır) -->
                                            <Border x:Name="NewProfilePanel" Visibility="Collapsed" CornerRadius="10" Background="#181D33" BorderBrush="#7C3AED" BorderThickness="1.5" Padding="16,14" Margin="0,0,0,14">
                                                <StackPanel>
                                                    <TextBlock Text="➕ Yeni Aydınlatma Profili Kaydet" FontWeight="Bold" FontSize="13.5" Foreground="#C084FC" Margin="0,0,0,6"/>
                                                    <TextBlock Text="O an aktif olan efekt, hız, açı, parlaklık ve tuş renkleriniz bu profil adı altında kalıcı olarak kaydedilecektir." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                            <TextBlock Text="Profil Adı:" FontSize="11" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                                                            <TextBox x:Name="NewProfileNameBox" Background="#0C0F1D" Foreground="#F8FAFC" BorderBrush="#2D3748" BorderThickness="1" Padding="8,6" FontSize="12"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                            <TextBlock Text="Açıklama (İsteğe Bağlı):" FontSize="11" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                                                            <TextBox x:Name="NewProfileDescBox" Background="#0C0F1D" Foreground="#F8FAFC" BorderBrush="#2D3748" BorderThickness="1" Padding="8,6" FontSize="12"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button Content="İptal" Click="CancelNewProfile_Click" Style="{StaticResource CyberButton}" Margin="0,0,8,0" Padding="14,6" FontSize="11"/>
                                                        <Button Content="✓ Profili Kaydet" Click="SaveNewProfile_Click" Style="{StaticResource PrimaryAccentButton}" Padding="16,6" FontSize="11"/>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>

                                            <ItemsControl ItemsSource="{Binding Profiles}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="10" Background="{StaticResource CardSubBgBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1.5" Padding="16,13" Margin="0,0,0,10">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Sol: Profil Başlığı & Açıklama -->
                                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="#F8FAFC" VerticalAlignment="Center" Margin="0,0,8,2"/>
                                                                        <Border Background="#211838" BorderBrush="#7C3AED" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,6,2" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding EffectId, StringFormat='Efekt: {0}'}" FontSize="10" FontWeight="Bold" Foreground="#C084FC"/>
                                                                        </Border>
                                                                        <Border Background="#142033" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,0,2" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Brightness, StringFormat='Parlaklık: %{0}'}" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                                                                        </Border>
                                                                    </WrapPanel>
                                                                    <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"/>
                                                                </StackPanel>

                                                                <!-- Orta: Renk Şeması Paleti (Color Swatches) -->
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,18,0">
                                                                    <TextBlock Text="Renk Şeması:" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                                                    <ItemsControl ItemsSource="{Binding PaletteColors}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <StackPanel Orientation="Horizontal"/>
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Border Width="20" Height="20" CornerRadius="10" Margin="0,0,6,0"
                                                                                        Background="{Binding}" BorderBrush="#3B4668" BorderThickness="1.5"/>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>

                                                                <!-- Sağ: Profil İşlem Butonları -->
                                                                <WrapPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Button Content="Uygula ➔" Click="ApplyProfileButton_Click"
                                                                            Tag="{Binding Name}" Style="{StaticResource PrimaryAccentButton}"
                                                                            Margin="0,2,6,2" Padding="12,7" FontSize="11.5"/>
                                                                    <Button Content="📤 Dışa Aktar" Click="ExportProfileButton_Click"
                                                                            Tag="{Binding}" Style="{StaticResource CyberButton}"
                                                                            Margin="0,2,6,2" Padding="10,7" FontSize="11"/>
                                                                    <Button Content="🗑️" ToolTip="Profili Sil" Click="DeleteProfileButton_Click"
                                                                            Tag="{Binding}" Style="{StaticResource CyberButton}"
                                                                            Margin="0,2,0,2" Padding="8,7" FontSize="11"/>
                                                                </WrapPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </TabItem>
                        </TabControl>
                    </Border>
                </Grid>
            </Grid>

            <!-- 3. SETTINGS & ABOUT MODAL OVERLAY -->
            <Grid x:Name="SettingsModalOverlay" Grid.RowSpan="2" Background="#E005070D" Visibility="Collapsed">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="520"
                        Background="#0F121E" BorderBrush="#7C3AED" BorderThickness="1.5" CornerRadius="14" Padding="24">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="32" ShadowDepth="8" Opacity="0.8" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- Modal Header -->
                        <Grid Margin="0,0,0,18">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="40" Height="40" CornerRadius="8" Background="#141829" BorderBrush="#7C3AED" BorderThickness="1.5" Margin="0,0,12,0" ClipToBounds="True">
                                    <Image Source="{StaticResource AppLogoImage}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="mrSpyCC" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                                        <Border Background="#7C3AED" CornerRadius="4" Padding="6,1" Margin="8,2,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="PRO" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        </Border>
                                        <TextBlock Text="v1.0" FontSize="12" Foreground="#A855F7" FontWeight="SemiBold" Margin="8,3,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="Kapsamlı RGB &amp; Donanım Kontrol Merkezi" FontSize="11" Foreground="#94A3B8"/>
                                </StackPanel>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="30" Height="30" Background="Transparent"
                                    BorderThickness="0" Cursor="Hand" Foreground="#94A3B8" Content="✕" FontSize="13" Click="CloseSettings_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" CornerRadius="6" Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="#EF4444"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <Separator Background="#22283D" Margin="0,0,0,16"/>

                        <!-- Developer & Organization Info -->
                        <Border Background="#151A2B" BorderBrush="#252F50" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Geliştirici:" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="mrSpy (Lead Reverse Engineer)" Foreground="#F8FAFC" FontWeight="Bold" FontSize="12" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Organizasyon:" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="aegisSoft" Foreground="#A855F7" FontWeight="Bold" FontSize="12" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Hedef Donanım:" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Tongfang / AiStone / Game Garaj (ITE8291)" Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="USB HID Kimliği:" Foreground="#94A3B8" FontSize="12"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="VID_048D &amp; PID_600B (Interface 01)" FontFamily="Consolas" Foreground="#38BDF8" FontSize="12"/>
                            </Grid>
                        </Border>

                        <!-- Interactive Web & GitHub Links -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Button Style="{StaticResource CyberButton}" Margin="0,0,10,0" Click="OpenGithub_Click" Cursor="Hand" Padding="16,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🌐 GitHub (MrSpy00)" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource CyberButton}" Click="OpenWebsite_Click" Cursor="Hand" Padding="16,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🏢 aegissoft.com.tr" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Auto Start Checkbox Inside Settings -->
                        <Border Background="#141829" CornerRadius="8" Padding="12,10" Margin="0,0,0,16" BorderBrush="#252D47" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Windows Açılışında Otomatik Başlat" FontWeight="SemiBold" FontSize="12" Foreground="#F8FAFC"/>
                                    <TextBlock Text="Oturum açıldığında yüksek yetkiyle arka planda başlar" FontSize="10.5" Foreground="#94A3B8"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding AutoStartEnabled}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Close Action Button -->
                        <Button Content="Kapat" Click="CloseSettings_Click" Style="{StaticResource PrimaryAccentButton}" HorizontalAlignment="Stretch" Height="36"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
