<Window x:Class="mrSpyCC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:mrSpyCC.UI.Controls"
        mc:Ignorable="d"
        Title="mrSpyCC PRO v1.0 — aegisSoft"
        Icon="pack://application:,,,/resources/app.ico"
        Height="950" Width="1460" MinHeight="660" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI, Segoe UI Variable Display, Arial"
        PreviewKeyDown="Window_PreviewKeyDown"
        SizeChanged="Window_SizeChanged">

    <!-- Native Resizing Chrome for Borderless Window -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="8" CornerRadius="16" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Downsampled Shared App Logo (Saves ~30 MB of uncompressed WIC bitmap cache) -->
        <BitmapImage x:Key="AppLogoImage" UriSource="pack://application:,,,/resources/logo.png" DecodePixelWidth="96" CacheOption="OnLoad"/>

        <!-- Modern Cyber Obsidian Palette -->
        <SolidColorBrush x:Key="WindowBgBrush" Color="#08090E"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#0F121E"/>
        <SolidColorBrush x:Key="CardSubBgBrush" Color="#151A2B"/>
        <SolidColorBrush x:Key="BorderSubtleBrush" Color="#22283D"/>
        <SolidColorBrush x:Key="BorderHighlightBrush" Color="#3B4668"/>
        <SolidColorBrush x:Key="AccentPurpleBrush" Color="#7C3AED"/>
        <SolidColorBrush x:Key="AccentPurpleLightBrush" Color="#A855F7"/>
        <SolidColorBrush x:Key="AccentCyanBrush" Color="#00F0FF"/>
        <SolidColorBrush x:Key="TextMainBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextDimBrush" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8"/>

        <!-- High-End Slim Cyber ScrollBar -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Stylus.IsFlicksEnabled" Value="false"/>
            <Setter Property="Foreground" Value="#2A334E"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="7"/>
            <Setter Property="MinWidth" Value="7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="ThumbBorder" Background="#26314D" CornerRadius="3.5" Margin="1,0"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#7C3AED"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#A855F7"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- High-Performance Soft Smooth Modern Slider (Click-To-Move with Dynamic Progress Fill) -->
        <Style TargetType="{x:Type Slider}">
            <Setter Property="Height" Value="24"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Cursor="Hand">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4.5" CornerRadius="2.5,0,0,2.5">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#6366F1" Offset="0"/>
                                                            <GradientStop Color="#7C3AED" Offset="0.6"/>
                                                            <GradientStop Color="#A855F7" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid x:Name="ThumbRoot">
                                                    <Ellipse x:Name="OuterGlow" Width="15" Height="15" Fill="#7C3AED" Stroke="#EDE9FE" StrokeThickness="1.5">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.75" Color="#8B5CF6"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                    <Ellipse Width="4" Height="4" Fill="#FFFFFF" Opacity="0.95"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="OuterGlow" Property="Fill" Value="#8B5CF6"/>
                                                        <Setter TargetName="OuterGlow" Property="Stroke" Value="#FFFFFF"/>
                                                        <Setter TargetName="OuterGlow" Property="Width" Value="17"/>
                                                        <Setter TargetName="OuterGlow" Property="Height" Value="17"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="OuterGlow" Property="Fill" Value="#6D28D9"/>
                                                        <Setter TargetName="OuterGlow" Property="Stroke" Value="#C084FC"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Cursor="Hand">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4.5" Background="#141829" BorderBrush="#222C46" BorderThickness="0,1,1,1" CornerRadius="0,2.5,2.5,0"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Red Channel Soft Smooth Slider -->
        <Style x:Key="RedSliderStyle" TargetType="{x:Type Slider}" BasedOn="{StaticResource {x:Type Slider}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Cursor="Hand">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4.5" CornerRadius="2.5,0,0,2.5">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#991B1B" Offset="0"/>
                                                            <GradientStop Color="#DC2626" Offset="0.7"/>
                                                            <GradientStop Color="#EF4444" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid x:Name="ThumbRoot">
                                                    <Ellipse x:Name="OuterGlow" Width="15" Height="15" Fill="#DC2626" Stroke="#FEE2E2" StrokeThickness="1.5">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.75" Color="#EF4444"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                    <Ellipse Width="4" Height="4" Fill="#FFFFFF" Opacity="0.95"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="OuterGlow" Property="Fill" Value="#EF4444"/>
                                                        <Setter TargetName="OuterGlow" Property="Stroke" Value="#FFFFFF"/>
                                                        <Setter TargetName="OuterGlow" Property="Width" Value="17"/>
                                                        <Setter TargetName="OuterGlow" Property="Height" Value="17"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="OuterGlow" Property="Fill" Value="#B91C1C"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Cursor="Hand">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4.5" Background="#141829" BorderBrush="#222C46" BorderThickness="0,1,1,1" CornerRadius="0,2.5,2.5,0"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Green Channel Soft Smooth Slider -->
        <Style x:Key="GreenSliderStyle" TargetType="{x:Type Slider}" BasedOn="{StaticResource {x:Type Slider}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Cursor="Hand">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4.5" CornerRadius="2.5,0,0,2.5">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#166534" Offset="0"/>
                                                            <GradientStop Color="#16A34A" Offset="0.7"/>
                                                            <GradientStop Color="#22C55E" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid x:Name="ThumbRoot">
                                                    <Ellipse x:Name="OuterGlow" Width="15" Height="15" Fill="#16A34A" Stroke="#DCFCE7" StrokeThickness="1.5">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.75" Color="#22C55E"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                    <Ellipse Width="4" Height="4" Fill="#FFFFFF" Opacity="0.95"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="OuterGlow" Property="Fill" Value="#22C55E"/>
                                                        <Setter TargetName="OuterGlow" Property="Stroke" Value="#FFFFFF"/>
                                                        <Setter TargetName="OuterGlow" Property="Width" Value="17"/>
                                                        <Setter TargetName="OuterGlow" Property="Height" Value="17"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="OuterGlow" Property="Fill" Value="#15803D"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Cursor="Hand">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4.5" Background="#141829" BorderBrush="#222C46" BorderThickness="0,1,1,1" CornerRadius="0,2.5,2.5,0"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Blue Channel Soft Smooth Slider -->
        <Style x:Key="BlueSliderStyle" TargetType="{x:Type Slider}" BasedOn="{StaticResource {x:Type Slider}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Cursor="Hand">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4.5" CornerRadius="2.5,0,0,2.5">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#1E40AF" Offset="0"/>
                                                            <GradientStop Color="#2563EB" Offset="0.7"/>
                                                            <GradientStop Color="#38BDF8" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid x:Name="ThumbRoot">
                                                    <Ellipse x:Name="OuterGlow" Width="15" Height="15" Fill="#2563EB" Stroke="#E0F2FE" StrokeThickness="1.5">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.75" Color="#38BDF8"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                    <Ellipse Width="4" Height="4" Fill="#FFFFFF" Opacity="0.95"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="OuterGlow" Property="Fill" Value="#38BDF8"/>
                                                        <Setter TargetName="OuterGlow" Property="Stroke" Value="#FFFFFF"/>
                                                        <Setter TargetName="OuterGlow" Property="Width" Value="17"/>
                                                        <Setter TargetName="OuterGlow" Property="Height" Value="17"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="OuterGlow" Property="Fill" Value="#1D4ED8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Cursor="Hand">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4.5" Background="#141829" BorderBrush="#222C46" BorderThickness="0,1,1,1" CornerRadius="0,2.5,2.5,0"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Cyber Button Style -->
        <Style x:Key="CyberButton" TargetType="Button">
            <Setter Property="Background" Value="#171C2E"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#2D3754"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#252E4B"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#7C3AED"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#101422"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Accent Violet Button -->
        <Style x:Key="PrimaryAccentButton" TargetType="Button">
            <Setter Property="Background" Value="#7C3AED"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#A855F7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.4" Color="#7C3AED"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#8B5CF6"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#C084FC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#6D28D9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Toggle Switch Style -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="42" Height="22" Margin="0,0,8,0">
                                <Border x:Name="SwitchTrack" CornerRadius="11" Background="#1D2336" BorderBrush="#2D3654" BorderThickness="1"/>
                                <Border x:Name="SwitchThumb" Width="16" Height="16" CornerRadius="8" Background="#94A3B8"
                                        HorizontalAlignment="Left" Margin="3,0,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3" Color="#000000"/>
                                    </Border.Effect>
                                </Border>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#7C3AED"/>
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#A855F7"/>
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,3,0"/>
                                <Setter TargetName="SwitchThumb" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#7C3AED"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- High-Contrast Zero-Clip Navigation TabControl Style -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid ClipToBounds="True" SnapsToDevicePixels="True" KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <WrapPanel x:Name="HeaderPanel" Grid.Row="0" IsItemsHost="True" Margin="0,0,0,2" Panel.ZIndex="1"/>
                            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent"
                                              Margin="0" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" CornerRadius="8" Background="#141929" BorderBrush="#28334E" BorderThickness="1.5"
                                Padding="16,8" Margin="0,0,8,2" Cursor="Hand">
                            <TextBlock x:Name="TabText" Text="{TemplateBinding Header}"
                                       FontSize="12.5" FontWeight="SemiBold" Foreground="#E2E8F0"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#7C3AED"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#C084FC"/>
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="1.5"/>
                                <Setter TargetName="TabText" Property="Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="TabText" Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="#1E2742"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#8B5CF6"/>
                                <Setter TargetName="TabText" Property="Foreground" Value="#FFFFFF"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Window Border with Rounded Corners (Zero Full-Window DropShadow RenderTarget Overhead) -->
    <Border Background="{StaticResource WindowBgBrush}" CornerRadius="12"
            BorderBrush="#252136" BorderThickness="1.5" Margin="0">

        <Grid>
            <Grid.RowDefinitions>
                <!-- 0: Custom Window Header & App Bar -->
                <RowDefinition Height="Auto"/>
                <!-- 1: Main Dashboard Body (Left: Effects & Categories, Right: Keyboard & Parameters) -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 0. CUSTOM WINDOW HEADER (DRAGGABLE & RESIZE COMPATIBLE) -->
            <Border Grid.Row="0" Background="#0F121D" CornerRadius="11,11,0,0"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                    Padding="14,10" MouseDown="Header_MouseDown" MouseMove="Header_MouseMove" MouseLeftButtonUp="Header_MouseUp">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- App Brand & Title -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Center Quick Status & Switch Pills -->
                        <ColumnDefinition Width="*"/>
                        <!-- Window Controls -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Brand Logo & Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- App Icon Image -->
                        <Border Width="34" Height="34" CornerRadius="8" Background="#141829" BorderBrush="#2C3754" BorderThickness="1" Margin="0,0,10,0" ClipToBounds="True">
                            <Image Source="{StaticResource AppLogoImage}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="mrSpyCC" FontSize="17" FontWeight="Bold" Foreground="#F8FAFC"/>
                                <Border Background="#7C3AED" CornerRadius="4" Padding="5,1" Margin="6,2,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="PRO" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                                </Border>
                                <TextBlock Text="v1.0" FontSize="11" Foreground="#A855F7" FontWeight="SemiBold" Margin="6,3,0,0"/>
                                <TextBlock Text="by aegisSoft" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="8,3,0,0"/>
                            </StackPanel>
                            <TextBlock Text="ITE8291 USB HID RGB &amp; Hardware Control Engine" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Center: Quick Status Badges & Auto-Start Switch -->
                    <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0">
                        <!-- Connection Status -->
                        <Border Background="#10261C" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,2,8,2">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#4ADE80" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ConnectionStatusText}" FontSize="11" FontWeight="SemiBold" Foreground="#4ADE80"/>
                            </StackPanel>
                        </Border>

                        <!-- Hardware Exclusive Lock Pill -->
                        <Border x:Name="LockStatusBorder" Background="#10261C" BorderBrush="#22C55E" BorderThickness="1.5" CornerRadius="6" Padding="10,4" Margin="0,2,8,2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="LockStatusTextBlock" Text="{Binding LockStatusText}" FontSize="11" FontWeight="Bold" Foreground="#4ADE80" VerticalAlignment="Center"/>
                                <Button x:Name="HeaderRelockBtn" Content="🔒 Kilidi Al" Click="RelockButton_Click" Margin="8,0,0,0" Padding="8,2" FontSize="10.5"
                                        FontWeight="Bold" Background="#7C3AED" Foreground="#FFFFFF" BorderBrush="#A855F7" BorderThickness="1"
                                        Cursor="Hand" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <!-- Auto-Start with Windows Toggle -->
                        <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding AutoStartEnabled}" Margin="0,2,8,2"
                                  ToolTip="Windows başladığında sessizce yüksek yetkiyle başlat">
                            <TextBlock Text="Oto-Başlat" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}"/>
                        </CheckBox>

                        <!-- Real-Time FPS Badge -->
                        <Border Background="#161B2E" BorderBrush="#252F50" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,2,6,2">
                            <TextBlock Text="{Binding FpsText}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                        </Border>

                        <!-- WPM Badge -->
                        <Border Background="#161B2E" BorderBrush="#252F50" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,2,0,2">
                            <TextBlock Text="{Binding WpmText}" FontSize="11" FontWeight="Bold" Foreground="#FBBF24"/>
                        </Border>
                    </WrapPanel>

                    <!-- Right: Window Controls (Settings Gear, Minimize, Maximize/Restore, Close) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Settings Gear Button -->
                        <Button x:Name="SettingsGearBtn" Click="SettingsGearBtn_Click" Width="34" Height="30" Margin="0,0,12,0" Background="Transparent"
                                BorderThickness="0" Cursor="Hand" Foreground="#CBD5E1" Content="⚙" FontSize="14" ToolTip="mrSpyCC PRO Hakkında &amp; Sistem Bilgisi">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" CornerRadius="6" Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#252E4B"/>
                                            <Setter Property="Foreground" Value="#A855F7"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Minimize Button -->
                        <Button Click="MinimizeButton_Click" Width="34" Height="30" Margin="0,0,3,0" Background="Transparent"
                                BorderThickness="0" Cursor="Hand" Foreground="#CBD5E1" Content="—" FontSize="13">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" CornerRadius="6" Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#1E2438"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Maximize / Restore Button -->
                        <Button x:Name="MaximizeButton" Click="MaximizeButton_Click" Width="34" Height="30" Margin="0,0,3,0" Background="Transparent"
                                BorderThickness="0" Cursor="Hand" Foreground="#CBD5E1" Content="🗖" FontSize="13">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" CornerRadius="6" Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#1E2438"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Close Button -->
                        <Button Click="CloseButton_Click" Width="34" Height="30" Background="Transparent"
                                BorderThickness="0" Cursor="Hand" Foreground="#CBD5E1" Content="✕" FontSize="13">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" CornerRadius="6" Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#EF4444"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 1. MAIN TWO-COLUMN DASHBOARD (Row 1) -->
            <Grid Grid.Row="1" Margin="14,10,14,14">
                <Grid.ColumnDefinitions>
                    <!-- SOL TARAF: Kategori Seçimi & Efektler Listesi (Baştan sona dikey / Full Height) -->
                    <ColumnDefinition Width="385" MinWidth="340" MaxWidth="460"/>
                    <!-- SAĞ TARAF: Ekranın Ortasından İkiye Bölünmüş (Üst: Klavye, Alt: Değişkenler & Sekmeler) -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ==================== SOL SÜTUN: EFEKT & ANİMASYON KATALOĞU (FULL HEIGHT) ==================== -->
                <Border Grid.Column="0" Background="{StaticResource CardBgBrush}" CornerRadius="12"
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Padding="14,12" Margin="0,0,12,0">
                    <DockPanel LastChildFill="True">
                        <!-- Üst Kategori Filtre Başlığı & Rozeti -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,0,8">
                                <TextBlock Text="⚡ Efekt &amp; Mod Kataloğu" Foreground="#F8FAFC" FontSize="13.5" FontWeight="Bold"/>
                                <Border Background="#211838" BorderBrush="#7C3AED" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="47+ Mod &amp; Efekt" FontSize="10" FontWeight="Bold" Foreground="#C084FC"/>
                                </Border>
                            </StackPanel>

                            <!-- Kategori Filtre Butonları (Yatay Kaydırılabilir Segmented Chips Ribbon) -->
                            <ScrollViewer x:Name="CategoryScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                          PanningMode="HorizontalOnly" Margin="0,0,0,4">
                                <ListBox x:Name="CategoryListBox"
                                         ItemsSource="{Binding Categories}"
                                         SelectedIndex="{Binding SelectedCategoryIndex, Mode=TwoWay}"
                                         Background="Transparent" BorderThickness="0"
                                         ScrollViewer.CanContentScroll="False"
                                         IsTextSearchEnabled="False">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,0,6,4"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="PillBorder" CornerRadius="6" Background="#141829" BorderBrush="#26314D" BorderThickness="1.5"
                                                                Padding="9,5">
                                                            <TextBlock x:Name="PillText" Text="{Binding}" FontSize="11" FontWeight="SemiBold" Foreground="#CBD5E1"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="PillBorder" Property="Background" Value="#7C3AED"/>
                                                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="#A855F7"/>
                                                                <Setter TargetName="PillText" Property="Foreground" Value="#FFFFFF"/>
                                                                <Setter TargetName="PillText" Property="FontWeight" Value="Bold"/>
                                                            </Trigger>
                                                            <MultiTrigger>
                                                                <MultiTrigger.Conditions>
                                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                                    <Condition Property="IsSelected" Value="False"/>
                                                                </MultiTrigger.Conditions>
                                                                <Setter TargetName="PillBorder" Property="Background" Value="#1D243B"/>
                                                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="#7C3AED"/>
                                                                <Setter TargetName="PillText" Property="Foreground" Value="#FFFFFF"/>
                                                            </MultiTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </ScrollViewer>
                        </DockPanel>

                        <!-- İnce Ayırıcı Çizgi -->
                        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,0,0,10"/>

                        <!-- Baştan Sona Boyutlanan Efekt Listesi -->
                        <ListBox x:Name="EffectsListBox" ItemsSource="{Binding FilteredEffects}"
                                 SelectedItem="{Binding SelectedEffectItem, Mode=TwoWay}"
                                 SelectionChanged="EffectsListBox_SelectionChanged"
                                 IsTextSearchEnabled="False"
                                 Background="Transparent" BorderThickness="0" Foreground="#F8FAFC"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ContainerBorder"
                                                        CornerRadius="8"
                                                        Background="#121626"
                                                        BorderBrush="#222C46"
                                                        BorderThickness="1.5"
                                                        Padding="10,9">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ContainerBorder" Property="Background" Value="#221838"/>
                                                        <Setter TargetName="ContainerBorder" Property="BorderBrush" Value="#7C3AED"/>
                                                        <Setter TargetName="ContainerBorder" Property="BorderThickness" Value="1.5"/>
                                                    </Trigger>
                                                    <MultiTrigger>
                                                        <MultiTrigger.Conditions>
                                                            <Condition Property="IsMouseOver" Value="True"/>
                                                            <Condition Property="IsSelected" Value="False"/>
                                                        </MultiTrigger.Conditions>
                                                        <Setter TargetName="ContainerBorder" Property="Background" Value="#181E33"/>
                                                        <Setter TargetName="ContainerBorder" Property="BorderBrush" Value="#3B486E"/>
                                                    </MultiTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="28"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding IconGlyph}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,4,0">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12.5" Foreground="#F8FAFC"/>
                                            <TextBlock Text="{Binding Description}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <!-- Favori Yıldız Butonu -->
                                        <Button Grid.Column="2"
                                                Click="FavoriteStar_Click"
                                                Tag="{Binding Id}"
                                                Cursor="Hand"
                                                ToolTip="{Binding StarToolTip}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Width="26" Height="26"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent" CornerRadius="4">
                                                        <TextBlock Text="{Binding StarGlyph}"
                                                                   FontSize="16"
                                                                   Foreground="{Binding StarBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- ==================== SAĞ SÜTUN: ORTADAN BÖLÜNMÜŞ (ÜST: KLAVYE, ALT: KONTROLLER) ==================== -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <!-- Üst Kısım: Canlı Klavye Önizlemesi (Yükseklik ~190-200px) -->
                        <RowDefinition Height="Auto"/>
                        <!-- Alt Kısım: Sabit Renk, Değişkenler & Sekmeler (Kalan alan) -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 1. ÜST KISIM: VIRTUAL KEYBOARD CANLI ÖNİZLEME KARTI -->
                    <Border Grid.Row="0" Background="{StaticResource CardBgBrush}" CornerRadius="12"
                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                            Padding="12,8" Margin="0,0,0,8">
                        <StackPanel>
                            <!-- Kart Üst Başlık & Tuş Telemetrisi -->
                            <Grid Margin="4,0,4,4">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⌨ Canlı Klavye Önizleme &amp; Donanım Haritası" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC"/>
                                    <Border Background="#161B2E" BorderBrush="#252F50" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Türkçe Q ISO (126 Tuş)" FontSize="9.5" FontWeight="SemiBold" Foreground="#38BDF8"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="Tıklanan / Etkileşim Tuşu: " FontSize="10.5" Foreground="{StaticResource TextDimBrush}"/>
                                    <TextBlock x:Name="LastClickedKeyText" Text="—" FontSize="10.5" FontWeight="Bold" Foreground="#A855F7"/>
                                </StackPanel>
                            </Grid>

                            <!-- İnteraktif Vektörel Klavye Bileşeni (Akıllı & Orantılı Ölçekli) -->
                            <Border x:Name="KeyboardPreviewBox" Height="192" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <controls:VirtualKeyboard x:Name="LiveKeyboard" KeyClicked="LiveKeyboard_KeyClicked"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 2. ALT KISIM: MAIN APPLICATION CONTENT TABS -->
                    <Border Grid.Row="1">
                        <TabControl x:Name="MainTabControl" SelectionChanged="MainTabControl_SelectionChanged">
                            <!-- TAB 0: AYDINLATMA & EFEKTLER (Değişkenler, Parlaklık, Renkler & Parametreler) -->
                            <TabItem Header="✨ Aydınlatma &amp; Efektler">
                                <Border Background="{StaticResource CardBgBrush}" CornerRadius="12"
                                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Padding="14,10" Margin="0,4,0,0">
                                    <ScrollViewer x:Name="ParametersScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                                        <StackPanel Orientation="Vertical" Margin="0,0,0,16">
                                            <!-- Aktif Efekt Başlığı & Kategori Rozeti -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding SelectedEffectItem.DisplayName}" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC"/>
                                                    <TextBlock Text="{Binding SelectedEffectItem.Description}" FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,1,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="🔄 Sıfırla" Click="ResetEffect_Click" Style="{StaticResource CyberButton}" Padding="9,4" FontSize="10.5" Margin="0,0,8,0" ToolTip="Aktif animasyonu veya mini oyunu baştan başlatır"/>
                                                    <Border Background="#211838" BorderBrush="#7C3AED" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SelectedEffectItem.Category, StringFormat='Kategori: {0}'}" FontSize="10.5" FontWeight="Bold" Foreground="#C084FC"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Master Brightness Bar with Inline Quick Presets & Click-to-Point Soft Slider -->
                                            <Border Background="{StaticResource CardSubBgBrush}" CornerRadius="9" Padding="10,7" Margin="0,0,0,8" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Genel Donanım Parlaklığı (Tıkla &amp; Kaydır)" FontWeight="SemiBold" FontSize="12" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="%0" Click="BrightnessPreset_Click" Tag="0" Style="{StaticResource CyberButton}" Padding="7,2" FontSize="9.5" Margin="0,0,4,0" ToolTip="Işıkları Kapat (%0)"/>
                                                            <Button Content="%25" Click="BrightnessPreset_Click" Tag="25" Style="{StaticResource CyberButton}" Padding="7,2" FontSize="9.5" Margin="0,0,4,0"/>
                                                            <Button Content="%50" Click="BrightnessPreset_Click" Tag="50" Style="{StaticResource CyberButton}" Padding="7,2" FontSize="9.5" Margin="0,0,4,0"/>
                                                            <Button Content="%75" Click="BrightnessPreset_Click" Tag="75" Style="{StaticResource CyberButton}" Padding="7,2" FontSize="9.5" Margin="0,0,4,0"/>
                                                            <Button Content="%100" Click="BrightnessPreset_Click" Tag="100" Style="{StaticResource CyberButton}" Padding="7,2" FontSize="9.5" Margin="0,0,10,0" ToolTip="Maksimum Parlaklık (%100)"/>
                                                            <TextBlock Text="{Binding Brightness, StringFormat='{}{0}%'}" Foreground="#A855F7" FontWeight="Bold" FontSize="12.5" Width="36" TextAlignment="Right" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <Slider Minimum="0" Maximum="100" Value="{Binding Brightness}" SmallChange="5" LargeChange="10" Height="20" IsMoveToPointEnabled="True"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- ==================== EVRENSEL RENK, ÇİFT RENK, STÜDYO PALETİ & RGB MOTORU ==================== -->
                                            <Border x:Name="GlobalColorStudioCard" Background="{StaticResource CardSubBgBrush}" CornerRadius="9" Padding="10,8" Margin="0,0,0,8"
                                                    BorderBrush="#283352" BorderThickness="1">
                                                <StackPanel>
                                                    <!-- Header & Active Color Mode Selector -->
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Vertical">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="🎨 Evrensel Renk, Çift Renk, Stüdyo Paleti &amp; RGB Motoru" FontWeight="Bold" FontSize="12" Foreground="#F8FAFC"/>
                                                                <Border Background="#1B1530" BorderBrush="#7C3AED" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="Tüm Efektlerde Aktif" FontSize="9.5" FontWeight="Bold" Foreground="#C084FC"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock x:Name="GlobalColorModeHintText"
                                                                       Text="Herhangi bir efekti tek renk, 2-renk geçişli, tam RGB gökkuşağı veya küratörlü stüdyo paletine dönüştürün."
                                                                       FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- 5 Universal Color Mode Buttons -->
                                                    <WrapPanel Margin="0,0,0,2">
                                                        <Button x:Name="GlobalModeDefaultBtn" Content="🎯 Varsayılan Mod" Click="GlobalColorMode_Click" Tag="0" Style="{StaticResource PrimaryAccentButton}" Padding="10,4" FontSize="10.5" Margin="0,0,6,4"/>
                                                        <Button x:Name="GlobalModeSingleBtn" Content="🟣 Tek Özel Renk" Click="GlobalColorMode_Click" Tag="1" Style="{StaticResource CyberButton}" Padding="10,4" FontSize="10.5" Margin="0,0,6,4"/>
                                                        <Button x:Name="GlobalModeDualBtn" Content="🎭 Çift Renk (2-Renk)" Click="GlobalColorMode_Click" Tag="2" Style="{StaticResource CyberButton}" Padding="10,4" FontSize="10.5" Margin="0,0,6,4"/>
                                                        <Button x:Name="GlobalModeRgbBtn" Content="🌈 Tam RGB Gökkuşağı" Click="GlobalColorMode_Click" Tag="3" Style="{StaticResource CyberButton}" Padding="10,4" FontSize="10.5" Margin="0,0,6,4"/>
                                                        <Button x:Name="GlobalModePaletteBtn" Content="✨ Stüdyo Paleti (8 Tema)" Click="GlobalColorMode_Click" Tag="4" Style="{StaticResource CyberButton}" Padding="10,4" FontSize="10.5" Margin="0,0,0,4"/>
                                                    </WrapPanel>

                                                    <!-- SUB-PANEL A: SINGLE & DUAL COLOR PICKERS -->
                                                    <StackPanel x:Name="GlobalCustomColorPanel" Visibility="Collapsed" Margin="0,2,0,0">
                                                        <!-- Dual-Color Quick Combos & Swap Toolbar -->
                                                        <Border x:Name="DualColorToolbar" Visibility="Collapsed" Background="#0C0F1A" BorderBrush="#1E263D" BorderThickness="1" CornerRadius="7" Padding="9,7" Margin="0,0,0,8">
                                                            <StackPanel>
                                                                <Grid Margin="0,0,0,6">
                                                                    <TextBlock Text="Hızlı Çift Renk (2-Renk) Kombinasyonları &amp; Geçiş Stili:" FontSize="10.5" FontWeight="SemiBold" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                                                    <Button Content="⇄ 1. ve 2. Rengi Takas Et" Click="SwapDualColors_Click" Style="{StaticResource CyberButton}" Padding="8,3" FontSize="10" HorizontalAlignment="Right"/>
                                                                </Grid>
                                                                <WrapPanel Margin="0,0,0,6">
                                                                    <Button Content="⚡ Siberpunk (Cyan/Mor)" Click="QuickDualCombo_Click" Tag="#00F0FF|#7C3AED" Style="{StaticResource CyberButton}" Padding="8,3" FontSize="10" Margin="0,0,5,4"/>
