<UserControl x:Class="mrSpyCC.UI.Controls.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="310" d:DesignWidth="360">

    <UserControl.Resources>
        <!-- Red Channel Slider -->
        <Style x:Key="RedPickerSlider" TargetType="{x:Type Slider}">
            <Setter Property="Height" Value="20"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Cursor="Hand">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2,0,0,2">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#7F1D1D" Offset="0"/>
                                                            <GradientStop Color="#DC2626" Offset="0.65"/>
                                                            <GradientStop Color="#FF3B5C" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse x:Name="OuterGlow" Width="13" Height="13" Fill="#EF4444" Stroke="#FFE4E6" StrokeThickness="1.5"/>
                                                    <Ellipse Width="3.5" Height="3.5" Fill="#FFFFFF"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="OuterGlow" Property="Fill" Value="#FF3B5C"/>
                                                        <Setter TargetName="OuterGlow" Property="Stroke" Value="#FFFFFF"/>
                                                        <Setter TargetName="OuterGlow" Property="Width" Value="14"/>
                                                        <Setter TargetName="OuterGlow" Property="Height" Value="14"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Cursor="Hand">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="#111522" BorderBrush="#1E263D" BorderThickness="0,1,1,1" CornerRadius="0,2,2,0"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Green Channel Slider -->
        <Style x:Key="GreenPickerSlider" TargetType="{x:Type Slider}">
            <Setter Property="Height" Value="20"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Cursor="Hand">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2,0,0,2">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#14532D" Offset="0"/>
                                                            <GradientStop Color="#16A34A" Offset="0.65"/>
                                                            <GradientStop Color="#10B981" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse x:Name="OuterGlow" Width="13" Height="13" Fill="#22C55E" Stroke="#DCFCE7" StrokeThickness="1.5"/>
                                                    <Ellipse Width="3.5" Height="3.5" Fill="#FFFFFF"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="OuterGlow" Property="Fill" Value="#10B981"/>
                                                        <Setter TargetName="OuterGlow" Property="Stroke" Value="#FFFFFF"/>
                                                        <Setter TargetName="OuterGlow" Property="Width" Value="14"/>
                                                        <Setter TargetName="OuterGlow" Property="Height" Value="14"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Cursor="Hand">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="#111522" BorderBrush="#1E263D" BorderThickness="0,1,1,1" CornerRadius="0,2,2,0"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Blue Channel Slider -->
        <Style x:Key="BluePickerSlider" TargetType="{x:Type Slider}">
            <Setter Property="Height" Value="20"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Cursor="Hand">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2,0,0,2">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#1E3A8A" Offset="0"/>
                                                            <GradientStop Color="#2563EB" Offset="0.65"/>
                                                            <GradientStop Color="#00F0FF" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse x:Name="OuterGlow" Width="13" Height="13" Fill="#38BDF8" Stroke="#E0F2FE" StrokeThickness="1.5"/>
                                                    <Ellipse Width="3.5" Height="3.5" Fill="#FFFFFF"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="OuterGlow" Property="Fill" Value="#00F0FF"/>
                                                        <Setter TargetName="OuterGlow" Property="Stroke" Value="#FFFFFF"/>
                                                        <Setter TargetName="OuterGlow" Property="Width" Value="14"/>
                                                        <Setter TargetName="OuterGlow" Property="Height" Value="14"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Cursor="Hand">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="#111522" BorderBrush="#1E263D" BorderThickness="0,1,1,1" CornerRadius="0,2,2,0"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#0C0F1A" BorderBrush="#1E263D" BorderThickness="1" CornerRadius="8" Padding="10,7">
        <StackPanel Orientation="Vertical">
            <!-- Header Row: Title + Live Color Preview + Editable Hex -->
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="82"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderTitleText" Text="Renk Stüdyosu &amp; Spektrum" Foreground="#E2E8F0" FontSize="11.5" FontWeight="Bold"/>
                    <TextBlock x:Name="RgbSummaryText" Text="RGB(124, 58, 237)" Foreground="#64748B" FontSize="9.5" FontFamily="Consolas" Margin="0,1,0,0"/>
                </StackPanel>

                <Border x:Name="ColorPreviewBorder" Grid.Column="1" Height="24" Width="24" CornerRadius="6"
                        Background="#7C3AED" BorderBrush="#E2E8F0" BorderThickness="1.5" Margin="6,0,6,0" VerticalAlignment="Center"/>

                <TextBox x:Name="HexInputTextBox" Grid.Column="2" Height="24" Background="#121728" Foreground="#F8FAFC"
                         BorderBrush="#26314F" BorderThickness="1" Padding="5,2" FontSize="11" FontFamily="Consolas" FontWeight="Bold"
                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                         Text="#7C3AED" TextChanged="HexInputTextBox_TextChanged"/>
            </Grid>

            <!-- 360° Interactive Hue Spectrum Bar -->
            <TextBlock Text="360° Renk Spektrumu (Dokun &amp; Sürükle)" Foreground="#94A3B8" FontSize="9.5" FontWeight="SemiBold" Margin="0,0,0,3"/>
            <Grid x:Name="HueBarContainer" Height="16" Margin="0,0,0,5" Cursor="Hand"
                  Background="Transparent"
                  MouseLeftButtonDown="HueBar_MouseLeftButtonDown"
                  MouseMove="HueBar_MouseMove"
                  MouseLeftButtonUp="HueBar_MouseLeftButtonUp"
                  SizeChanged="SpectrumBars_SizeChanged">
                <Border Height="11" CornerRadius="5.5" BorderBrush="#2A3656" BorderThickness="1" VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF0000" Offset="0.000"/>
                            <GradientStop Color="#FFFF00" Offset="0.167"/>
                            <GradientStop Color="#00FF00" Offset="0.333"/>
                            <GradientStop Color="#00FFFF" Offset="0.500"/>
                            <GradientStop Color="#0000FF" Offset="0.667"/>
                            <GradientStop Color="#FF00FF" Offset="0.833"/>
                            <GradientStop Color="#FF0000" Offset="1.000"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Canvas IsHitTestVisible="False" VerticalAlignment="Center" Height="16">
                    <Border x:Name="HueThumb" Width="8" Height="16" CornerRadius="4"
                            Background="#FFFFFF" BorderBrush="#090B10" BorderThickness="1.5" Canvas.Left="0" Canvas.Top="0"/>
                </Canvas>
            </Grid>

            <!-- Interactive Saturation & Tone Bar (White Pastel -> Pure Neon -> Deep Shade) -->
            <TextBlock Text="Doygunluk &amp; Ton (Pastel ➔ Saf Neon ➔ Koyu)" Foreground="#94A3B8" FontSize="9.5" FontWeight="SemiBold" Margin="0,0,0,3"/>
            <Grid x:Name="ToneBarContainer" Height="15" Margin="0,0,0,6" Cursor="Hand"
                  Background="Transparent"
                  MouseLeftButtonDown="ToneBar_MouseLeftButtonDown"
                  MouseMove="ToneBar_MouseMove"
                  MouseLeftButtonUp="ToneBar_MouseLeftButtonUp"
                  SizeChanged="SpectrumBars_SizeChanged">
                <Border Height="10" CornerRadius="5" BorderBrush="#2A3656" BorderThickness="1" VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush x:Name="ToneBarGradient" StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFFFFF" Offset="0.0"/>
                            <GradientStop x:Name="TonePureHueStop" Color="#7C3AED" Offset="0.5"/>
                            <GradientStop Color="#05070C" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Canvas IsHitTestVisible="False" VerticalAlignment="Center" Height="15">
                    <Border x:Name="ToneThumb" Width="8" Height="15" CornerRadius="4"
                            Background="#FFFFFF" BorderBrush="#090B10" BorderThickness="1.5" Canvas.Left="0" Canvas.Top="0"/>
                </Canvas>
            </Grid>

            <!-- 16 Calibrated Hardware Swatches -->
            <TextBlock Text="Kalibre Donanım Renkleri" Foreground="#94A3B8" FontSize="9.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <WrapPanel x:Name="SwatchesPanel" Margin="0,0,0,5"/>

            <!-- Precision RGB Channel Sliders -->
            <Grid Margin="0,0,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>
                <Border Background="#231116" BorderBrush="#DC2626" BorderThickness="1" CornerRadius="4" Width="18" Height="18" HorizontalAlignment="Left">
                    <TextBlock Text="R" Foreground="#EF4444" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Slider x:Name="SliderR" Grid.Column="1" Style="{StaticResource RedPickerSlider}" Minimum="0" Maximum="255" SmallChange="1" LargeChange="16"
                        ValueChanged="RgbSlider_ValueChanged" VerticalAlignment="Center" Margin="4,0,6,0"/>
                <Border Grid.Column="2" Background="#121626" BorderBrush="#232B44" BorderThickness="1" CornerRadius="4" Height="18" Padding="2,0">
                    <TextBlock x:Name="TextR" Text="124" Foreground="#F8FAFC" FontSize="10.5" FontFamily="Consolas" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>
                <Border Background="#102318" BorderBrush="#16A34A" BorderThickness="1" CornerRadius="4" Width="18" Height="18" HorizontalAlignment="Left">
                    <TextBlock Text="G" Foreground="#22C55E" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Slider x:Name="SliderG" Grid.Column="1" Style="{StaticResource GreenPickerSlider}" Minimum="0" Maximum="255" SmallChange="1" LargeChange="16"
                        ValueChanged="RgbSlider_ValueChanged" VerticalAlignment="Center" Margin="4,0,6,0"/>
                <Border Grid.Column="2" Background="#121626" BorderBrush="#232B44" BorderThickness="1" CornerRadius="4" Height="18" Padding="2,0">
                    <TextBlock x:Name="TextG" Text="58" Foreground="#F8FAFC" FontSize="10.5" FontFamily="Consolas" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>
                <Border Background="#111C30" BorderBrush="#2563EB" BorderThickness="1" CornerRadius="4" Width="18" Height="18" HorizontalAlignment="Left">
                    <TextBlock Text="B" Foreground="#38BDF8" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Slider x:Name="SliderB" Grid.Column="1" Style="{StaticResource BluePickerSlider}" Minimum="0" Maximum="255" SmallChange="1" LargeChange="16"
                        ValueChanged="RgbSlider_ValueChanged" VerticalAlignment="Center" Margin="4,0,6,0"/>
                <Border Grid.Column="2" Background="#121626" BorderBrush="#232B44" BorderThickness="1" CornerRadius="4" Height="18" Padding="2,0">
                    <TextBlock x:Name="TextB" Text="237" Foreground="#F8FAFC" FontSize="10.5" FontFamily="Consolas" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
